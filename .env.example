# API 설정
# Yahoo Finance는 API 키가 필요없지만, 향후 확장을 위해 준비

# FnGuide API (선택사항)
# FNGUIDE_API_KEY=your_api_key_here

# DART API (과거 재무제표 조회용 - 강력 권장)
# 발급 방법:
#   1. https://opendart.fss.or.kr/ 접속
#   2. 회원가입 / 로그인
#   3. '인증키 신청/관리' > '인증키 발급 신청'
#   4. 발급된 40자리 키를 아래에 입력
DART_API_KEY=your_dart_api_key_here

# 캐시 설정
CACHE_DIR=./data/cache
CACHE_TTL_STOCK_PRICE=3600  # 1시간
CACHE_TTL_FINANCIAL=86400   # 24시간

# 로깅 레벨
LOG_LEVEL=INFO
